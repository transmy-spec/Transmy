# Development-only example. Copy to .env and replace every CHANGE_ME value.
APP_ENV=development
APP_PUBLIC_URL=https://localhost
APP_LOG_LEVEL=INFO
VITE_DEFAULT_LOCALE=fr
APP_DATABASE_NAME=transmissions
APP_DATABASE_USER=transmissions_app
FIELD_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
APP_DATABASE_PASSWORD=CHANGE_ME_WITH_A_LONG_RANDOM_VALUE

KEYCLOAK_DATABASE_NAME=keycloak
KEYCLOAK_DATABASE_USER=keycloak_app
KEYCLOAK_DATABASE_PASSWORD=CHANGE_ME_WITH_ANOTHER_LONG_RANDOM_VALUE
KEYCLOAK_BOOTSTRAP_ADMIN_USERNAME=local-admin
KEYCLOAK_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_WITH_A_THIRD_LONG_RANDOM_VALUE
OIDC_CLIENT_SECRET=CHANGE_ME_WITH_A_FOURTH_LONG_RANDOM_VALUE
SESSION_SECRET=CHANGE_ME_WITH_A_FIFTH_LONG_RANDOM_VALUE
BACKUP_ENCRYPTION_PASSWORD=CHANGE_ME_WITH_A_SIXTH_LONG_RANDOM_VALUE
BACKUP_RETENTION_COUNT=14
BACKUP_MAX_AGE_HOURS=26
RESTORE_MAX_AGE_HOURS=744
INTEGRATION_ALLOWED_HOSTS=host.docker.internal

# Production override only
APP_DOMAIN=transmissions.example.org
ACME_EMAIL=exploitation@example.org
